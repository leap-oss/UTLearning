GEMINI_THINKING_LEVEL=low
AI_MAX_CONCURRENT_JOBS=1
AI_MAX_QUEUED_JOBS=3
AI_MAX_RETRIES=2
AI_RETRY_BASE_MS=1000
AI_RETRY_MAX_MS=30000
AI_ENABLE_GOOGLE_SEARCH=false
AI_MAX_IMAGES_PER_BATCH=15
AI_MAX_IMAGE_BYTES=8000000
AI_MAX_BATCH_BYTES=50000000
AI_MAX_OUTPUT_TOKENS_EXTRACTION=65536
AI_MAX_OUTPUT_TOKENS_STUDY_PACK=65536
